{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "artifact": {
      "type": "string",
      "const": "intent-aggregate"
    },
    "schemaVersion": {
      "type": "string",
      "const": "guilda.governance/v1"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "created-at": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "authorized-by": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "revision",
        "created-at",
        "owner",
        "authorized-by"
      ],
      "additionalProperties": false
    },
    "originates-from": {
      "type": "object",
      "properties": {
        "initiative-ref": {
          "type": "string",
          "minLength": 1
        },
        "activation-decision-ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "initiative-ref",
        "activation-decision-ref"
      ],
      "additionalProperties": false
    },
    "enquadramento": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "principles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "factual-baseline": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "risks-and-mitigations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "risk": {
                "type": "string",
                "minLength": 1
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "risk",
              "mitigation"
            ],
            "additionalProperties": false
          }
        },
        "global-gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "title",
        "context",
        "principles",
        "factual-baseline",
        "risks-and-mitigations",
        "global-gates"
      ],
      "additionalProperties": false
    },
    "objetivo": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "approach": {
          "type": "string",
          "enum": [
            "validate-first",
            "direct"
          ]
        },
        "approach-note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "capability",
        "approach",
        "approach-note"
      ],
      "additionalProperties": false
    },
    "target-outcome": {
      "type": "object",
      "properties": {
        "metric-ref": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "ecosystem": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "repositoryId": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "namespace": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "kind": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "id": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema4"
                    }
                  },
                  "required": [
                    "ecosystem",
                    "repositoryId",
                    "namespace",
                    "kind",
                    "id",
                    "revision"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "namespace": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "kind": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "id": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema4"
                    }
                  },
                  "required": [
                    "namespace",
                    "kind",
                    "id",
                    "revision"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "target-ref": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "ecosystem": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "repositoryId": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "namespace": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "kind": {
                      "$ref": "#/$defs/__schema5"
                    },
                    "id": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema4"
                    }
                  },
                  "required": [
                    "ecosystem",
                    "repositoryId",
                    "namespace",
                    "kind",
                    "id",
                    "revision"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "namespace": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "kind": {
                      "$ref": "#/$defs/__schema5"
                    },
                    "id": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema4"
                    }
                  },
                  "required": [
                    "namespace",
                    "kind",
                    "id",
                    "revision"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "metric-ref",
        "target-ref"
      ],
      "additionalProperties": false
    },
    "decision-gate": {
      "type": "object",
      "properties": {
        "activation-gate-ref": {
          "type": "string",
          "minLength": 1
        },
        "decided-by": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "activation-gate-ref",
        "decided-by"
      ],
      "additionalProperties": false
    },
    "signal": {
      "type": "string",
      "enum": [
        "none",
        "touches-contract",
        "operational-target"
      ]
    },
    "operational-posture": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "active"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "paused"
            },
            "since": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "resume-when": {
              "type": "object",
              "properties": {
                "intent": {
                  "$ref": "#/$defs/__schema6"
                },
                "governance-root": {
                  "$ref": "#/$defs/__schema6"
                },
                "work-id": {
                  "$ref": "#/$defs/__schema6"
                }
              },
              "required": [
                "intent",
                "governance-root",
                "work-id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "since",
            "resume-when"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "artifact",
    "schemaVersion",
    "metadata",
    "originates-from",
    "enquadramento",
    "objetivo",
    "target-outcome",
    "decision-gate",
    "signal",
    "operational-posture"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "string",
      "$comment": "Este ponto possui refinamentos canônicos sem equivalente automático em JSON Schema. Consulte semantics.md; aceitação estrutural não prova validade semântica."
    },
    "__schema3": {
      "type": "string",
      "const": "metric-definition"
    },
    "__schema4": {
      "$ref": "#/$defs/__schema2",
      "$comment": "Este ponto possui refinamentos canônicos sem equivalente automático em JSON Schema. Consulte semantics.md; aceitação estrutural não prova validade semântica."
    },
    "__schema5": {
      "type": "string",
      "const": "business-target"
    },
    "__schema6": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "$id": "https://raw.githubusercontent.com/rosanarezende/guilda-docs/main/schemas/1.0.0/intent.schema.json",
  "title": "intent",
  "$comment": "MIT. Exportação estrutural dos registros canônicos. Refinamentos sem representação JSON Schema e integridade entre arquivos: semantics.md. Não valida autoridade nem executa o produto."
}
